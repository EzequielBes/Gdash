# ==============================================
# GDASH Environment Variables Example
# ==============================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.

# ----------------------------------------------
# 🌍 Global Configuration
# ----------------------------------------------
NODE_ENV=development
PORT=3001

# ----------------------------------------------
# 🗄️ Database (MongoDB)
# ----------------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secure_password_123

# ----------------------------------------------
# 🐇 Message Broker (RabbitMQ)
# ----------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ----------------------------------------------
# 🔐 Security (JWT & Auth)
# ----------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=1d

# Usuário Admin Padrão (Criado na inicialização se não existir)
DEFAULT_USER_EMAIL=admin@gdash.local
DEFAULT_USER_PASSWORD=123456

# ----------------------------------------------
# 🐍 Collector Service (Python)
# ----------------------------------------------
# Cidades para monitoramento inicial (separadas por vírgula)
CITIES=São Paulo,Rio de Janeiro,Curitiba,Salvador,Brasília
# Coordenadas padrão (fallback)
LATITUDE=-23.5505
LONGITUDE=-46.6333
# Intervalo de coleta em segundos
COLLECTION_INTERVAL=60
PYTHON_LOG_LEVEL=INFO

# ----------------------------------------------
# 🐹 Worker Service (Go)
# ----------------------------------------------
GO_LOG_LEVEL=info

# ----------------------------------------------
# ⚛️ Frontend (React + Vite)
# ----------------------------------------------
# URL da API Backend (acessível pelo navegador)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_NAME="GDASH Weather"
